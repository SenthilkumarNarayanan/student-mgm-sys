{
  "name": "student-management-system",
  "version": "1.0.0",
  "description": "Student Management System with Angular + Node.js + Express + MongoDB",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "erver": "nodemon server.js",
    "client": "cd ../student-management-system && ng serve",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd ../student-management-system && npm run build",
    "heroku-postbuild": "cd ../student-management-system && npm install && npm run build",

    "test": "echo \"Error: no test specified\" && exit 1"
  },
    "engines": {
    "node": "20.x",
    "npm": "10.x"
  },

  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.3",
    "nodemailer": "^8.0.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "@angular/cli": "^21.2.5"

  }
}
